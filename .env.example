# URL pública canônica do site (sem barra final)
SITE_URL=https://www.sindicone.com.br

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Formulário de contato (Cloudflare Pages Function /api/contato)
# URL do serviço que recebe o lead em JSON (ex.: webhook de formulário/automação). Sem ela, o form oferece WhatsApp.
FORM_ENDPOINT=
# Opcional: token enviado como "Authorization: Bearer ..." ao FORM_ENDPOINT (cadastrar como Secret no Cloudflare)
FORM_ENDPOINT_TOKEN=
# Origens aceitas, separadas por vírgula
ALLOWED_ORIGINS=https://www.sindicone.com.br
# Número usado no link de WhatsApp de fallback (DDI+DDD+número)
WHATSAPP_NUMBER=

# Login GitHub do Decap CMS (/admin) via Pages Functions /api/auth e /api/callback
# Criar um OAuth App no GitHub com callback https://www.sindicone.com.br/api/callback
GITHUB_CLIENT_ID=
# Cadastrar como Secret no Cloudflare; nunca commitar
GITHUB_CLIENT_SECRET=
OAUTH_SCOPE=repo
