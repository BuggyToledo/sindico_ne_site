# URL pública canônica do site (sem barra final)
SITE_URL=https://www.sindicone.com.br

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5JKJHM2SFL

# Credenciais do Painel Editorial Integrado (EXCLUSIVO NO SERVIDOR - NUNCA USAR NEXT_PUBLIC_)
CMS_SESSION_SECRET=sindicone-cms-hmac-secret-change-in-production-2026
CMS_ADMIN_EMAIL=contato@sindicone.com.br
CMS_ADMIN_PASSWORD=sindicone-admin-2026
CMS_EDITOR_EMAIL=editor@sindicone.com.br
CMS_EDITOR_PASSWORD=sindicone-editor-2026
CMS_AUTHOR_EMAIL=autor@sindicone.com.br
CMS_AUTHOR_PASSWORD=sindicone-autor-2026
CMS_PREVIEW_SECRET=sindicone-preview-token-2026

# Integração Opcional WordPress Headless (Desativada por padrão; usa o repositório local migrado com fallback)
WP_HEADLESS_ENABLED=false
WP_HEADLESS_API_URL=https://www.sindicone.com.br/wp-json/wp/v2
WP_HEADLESS_USERNAME=
WP_HEADLESS_APP_PASSWORD=

# Configuração de E-mail do Formulário de Contato (/api/contact)
CONTACT_RECEIVER_EMAIL=contato@sindicone.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
