{
  "name": "sindico-ne-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional, blog editorial e CMS integrado da Síndico Né! (Next.js + React + TypeScript)",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:validate": "node scripts/validate-project.mjs",
    "preview": "npx -y serve out",
    "cms:local": "npx -y decap-server",
    "test:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.511.0",
    "marked": "^15.0.12",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
